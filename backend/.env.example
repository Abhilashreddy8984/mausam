# ============================================================
# Mausam Backend — Environment Variables Template
# ============================================================
#
# Copy this file to .env and fill in real values.
# .env is git-ignored — NEVER commit credentials to source control.
#
#   cp .env.example .env
#
# ============================================================

# ── Weather provider selection ───────────────────────────────
# "demo"  — hard-coded demo data, no credentials required (default)
# "imd"   — official IMD API (requires all IMD_* variables below)
# NOTE: value must be lowercase
WEATHER_PROVIDER=demo

# ── IMD OAuth credentials (JWT authentication) ───────────────
# Required when WEATHER_PROVIDER=imd
# Used ONLY to obtain a JWT Bearer token from the IMD OAuth endpoint.
# POST https://api.imd.gov.in/api/oauth/token.php
# NEVER share or commit real credentials.
IMD_EMAIL=your_imd_registered_email@example.com
IMD_PASSWORD=YOUR_IMD_ACCOUNT_PASSWORD_HERE

# IMD OAuth token endpoint (override only if IMD changes this URL)
IMD_TOKEN_URL=https://api.imd.gov.in/api/oauth/token.php

# ── IMD API credentials ──────────────────────────────────────
# Required only when WEATHER_PROVIDER=imd
# Obtain from: India Meteorological Department / MoES
# NEVER share or commit your real API key.
IMD_API_KEY=YOUR_IMD_API_KEY_HERE

# ── IMD Authentication header ────────────────────────────────
# HTTP header name used to pass the API key.
# Default: X-Api-Key  — change if IMD confirms a different header name.
IMD_AUTH_HEADER=X-Api-Key

# ── IMD API endpoint URLs ────────────────────────────────────
# Official IMD API base: https://api.imd.gov.in/api/v1/
# Reference: https://api.imd.gov.in/public/api_reference.html
IMD_CURRENT_WX_URL=https://api.imd.gov.in/api/v1/current_wx
IMD_CITY_FORECAST_URL=https://api.imd.gov.in/api/v1/cityforecastloc
IMD_NOWCAST_URL=https://api.imd.gov.in/api/v1/districtnowcast
IMD_WARNINGS_URL=https://api.imd.gov.in/api/v1/districtwarning

# ── IMD Station / District identifiers ───────────────────────
# The official IMD API identifies locations by NUMERIC IDs, not city names.
# These must be set to valid IMD identifiers for your target location.
#
# IMD_STATION_ID:
#   Numeric station ID for current_wx queries.
#   Example: "42867" = Hyderabad (Begumpet) synoptic station.
#   Find your station at: https://api.imd.gov.in/api/v1/current_wx
#   (returns all stations when called without ?id=)
IMD_STATION_ID=YOUR_STATION_ID_HERE

# IMD_FORECAST_STATION_CODE:
#   Station code for cityforecastloc queries.
#   Example: "42182" (verify for your city at
#   https://api.imd.gov.in/api/v1/cityforecast_mapping)
IMD_FORECAST_STATION_CODE=YOUR_FORECAST_STATION_CODE_HERE

# IMD_DISTRICT_WARNING_ID:
#   Numeric Obj_id for districtwarning queries.
#   Example: "573" (verify for your district at
#   https://api.imd.gov.in/api/v1/districtwarning)
IMD_DISTRICT_WARNING_ID=YOUR_DISTRICT_WARNING_ID_HERE

# IMD_DISTRICT_NOWCAST_ID:
#   Numeric district ID for districtnowcast queries.
#   Example: "1" (verify at
#   https://api.imd.gov.in/api/v1/districtnowcast)
IMD_DISTRICT_NOWCAST_ID=YOUR_DISTRICT_NOWCAST_ID_HERE

# ── HTTP client settings ─────────────────────────────────────
# Timeout in seconds for outbound API requests (default: 10)
HTTP_TIMEOUT_SECONDS=15
